# =========================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# =========================================

# =========================================
# Supabase (Vector Store)
# =========================================
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# ⚠️  Use service_role key (NOT anon/public key) — bypasses Row Level Security
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-key

# =========================================
# Database (Supabase PostgreSQL)
# =========================================
# Get from: Supabase Dashboard → Project Settings → Database → Connection String
# MUST use postgresql+asyncpg:// (NOT postgresql://)
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# =========================================
# Google Gemini (LLM + Embeddings)
# =========================================
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...your-gemini-api-key
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
LLM_TEMPERATURE=0.1

# =========================================
# Application
# =========================================
ENVIRONMENT=production
DEBUG=false
# Comma-separated list of allowed CORS origins (your Vercel URL)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# =========================================
# LangSmith Tracing (Optional)
# =========================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-rag-assistant

# =========================================
# Security
# =========================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
