# =========================================
# APPLICATION CONFIGURATION
# =========================================
APP_ENV=development
APP_NAME=agentic-rag-assistant
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# =========================================
# BACKEND API
# =========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# =========================================
# DATABASE (PostgreSQL via Supabase)
# =========================================
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project.supabase.co:5432/postgres

# =========================================
# VECTOR STORE (Supabase pgvector)
# =========================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# =========================================
# LLM & EMBEDDINGS (Google Gemini)
# =========================================
GOOGLE_API_KEY=your-google-api-key
EMBEDDING_MODEL=models/gemini-embedding-001
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# =========================================
# OBSERVABILITY (LangSmith — optional)
# =========================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-rag-assistant

# =========================================
# SECURITY
# =========================================
SECRET_KEY=super-secret-jwt-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
