# =========================================
# APPLICATION CONFIGURATION
# =========================================
APP_ENV=development
APP_NAME=agentic-rag-assistant
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# =========================================
# BACKEND API
# =========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# =========================================
# DATABASE (PostgreSQL + pgvector)
# =========================================
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=super_secret_password_change_me
POSTGRES_DB=rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag_user:super_secret_password_change_me@localhost:5432/rag_db

# =========================================
# VECTOR STORE (ChromaDB local / Pinecone prod)
# =========================================
VECTOR_STORE_PROVIDER=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=company_policies
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=

# =========================================
# LLM & EMBEDDINGS
# =========================================
OPENAI_API_KEY=sk-your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# =========================================
# OBSERVABILITY (LangSmith)
# =========================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your-langsmith-api-key
LANGCHAIN_PROJECT=agentic-rag-assistant

# =========================================
# SECURITY
# =========================================
SECRET_KEY=super-secret-jwt-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
